DATABASE_URL="postgresql://user:password@localhost:5432/patent_horizon_dev?schema=public"

# USPTO Open Data Portal API key, used to enrich patents with Patent Term
# Adjustment data. Requires a USPTO.gov account + ID.me identity verification
# to obtain — see README.md "Patent Term Adjustment enrichment" section.
USPTO_ODP_API_KEY=""

# CourtListener API key, used to track Hatch-Waxman/ANDA federal litigation
# (District of Delaware and District of New Jersey only) via the free RECAP
# API. Requires a free courtlistener.com account — see README.md "Data
# ingestion: Federal Litigation Tracking" for setup and this pipeline's
# rate-limit constraints (5 req/min, 50/hour, 125/day).
COURTLISTENER_API_KEY=""

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Comma-separated emails that get the elevated "Analyst" role at signup.
ANALYST_EMAILS=""

# Shared secret for the internal, unauthenticated-by-cookie
# /api/internal/patent-lookup endpoint used by Markman (a separate
# product) for read-only patent/drug regulatory data lookups. Generate
# with: openssl rand -base64 32. Must match Markman's
# PATENT_HORIZON_INTERNAL_API_KEY exactly.
INTERNAL_LOOKUP_API_KEY=""
