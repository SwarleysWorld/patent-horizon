// Prisma schema for Patent Horizon
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// FDA application types. This vocabulary is fixed by statute and does not
// change, so it's safe to model as an enum (unlike patent/exclusivity codes
// below, which are deliberately kept as open strings).
enum ApplicationType {
  NDA
  ANDA
  BLA
}

// Coarse "modality" — the structural category of a therapy, not its
// mechanism/indication. Classified heuristically from the active
// ingredient / proper name via real WHO INN / USAN naming-stem conventions
// (see src/lib/classification/modality.ts) — not authoritative. Shared by
// both Drug (small molecules, Orange Book) and BiologicProduct (Purple
// Book) — named without a "Drug" prefix for exactly that reason.
//
// UNCLASSIFIED is distinct from SMALL_MOLECULE: "no stem matched" is only
// evidence of small-molecule chemistry for Orange Book's NDA/ANDA
// regulatory pathway (see classifyModality's `fallback` parameter) — for
// biologics, an unmatched name must never be assumed small-molecule, so it
// lands here instead. CELL_THERAPY / GENE_THERAPY / VACCINE have no
// small-molecule analogue; MONOCLONAL_ANTIBODY now actually matches real
// rows once Purple Book is ingested (previously always zero — Orange Book
// alone doesn't cover biologics, which are regulated under BLA).
enum Modality {
  SMALL_MOLECULE
  PEPTIDE
  OLIGONUCLEOTIDE
  MONOCLONAL_ANTIBODY
  CELL_THERAPY
  GENE_THERAPY
  VACCINE
  OTHER
  UNCLASSIFIED
}

// FDA BPCIA license pathway for a biologic product — a fixed, statutory
// vocabulary, so an enum (unlike Exclusivity.code below).
// STANDARD       = 351(a) — includes both true reference products and
//                  unrelated standalone biologics (e.g. vaccines) with no
//                  biosimilar filed against them.
// BIOSIMILAR     = 351(k) biosimilar.
// INTERCHANGEABLE = 351(k) interchangeable.
enum LicenseType {
  STANDARD
  BIOSIMILAR
  INTERCHANGEABLE
}

// Which FDA center regulates the product — CDER (small molecules plus most
// therapeutic biologics) vs CBER (vaccines, blood products, cellular and
// gene therapies). Purple Book covers both in one file.
enum BiologicCenter {
  CDER
  CBER
}

// The company that holds an FDA application (innovator or generic
// applicant/BLA holder) — shared across both Orange Book Drugs and Purple
// Book BiologicProducts, matched by name the same way for both.
model Company {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  drugs            Drug[]
  biologicProducts BiologicProduct[]

  // Stamped after every litigation-pipeline check of this company (found
  // or not) — see src/lib/ingestion/litigation/index.ts. Null = never
  // checked. Powers resumable batching across the CourtListener API's
  // hard rate limit (5 req/min, 125/day) without touching
  // IngestionRecord's exactly-one-parent CHECK constraint.
  litigationLastCheckedAt DateTime?

  litigationCasesAsPlaintiff LitigationCase[] @relation("LitigationPlaintiff")
  litigationCasesAsDefendant LitigationCase[] @relation("LitigationDefendant")

  settlementCounterpartyLinks SettlementDisclosure[] @relation("SettlementCounterparty")

  @@index([litigationLastCheckedAt])
}

// One approved drug PRODUCT: a specific brand/generic name + dosage form +
// route + strength under one FDA application. This mirrors the FDA Orange
// Book's own "Products" file (Appl_Type, Appl_No, Product_No, Trade_Name,
// Ingredient, DF;Route, Strength, Applicant) row-for-row, since that's the
// primary ingestion source and grain mismatches there cause the most pain.
model Drug {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  brandName   String
  genericName String // active ingredient(s) as free text, e.g. "amlodipine and valsartan"

  applicationType   ApplicationType
  applicationNumber String // e.g. "NDA020702"
  productNumber     String // e.g. "001" — distinguishes strengths/forms within one application

  dosageForm String // e.g. "TABLET"
  route      String // e.g. "ORAL"
  strength   String // e.g. "10MG"

  // Best-effort classification, set at ingestion time (and backfillable via
  // scripts/classify-drugs.ts) — see src/lib/classification/. modality is
  // the small fixed taxonomy above; drugClass is an open, best-effort
  // mechanism/therapeutic tag (e.g. "Statin", "ACE inhibitor") from the
  // same naming-stem approach — kept as a nullable free string rather than
  // an enum because that vocabulary is large, growing, and nowhere near as
  // reliably detectable as modality (matches the reasoning already applied
  // to Exclusivity.code).
  modality  Modality @default(SMALL_MOLECULE)
  drugClass String?

  approvalDate DateTime?

  // Stamped after every settlements-pipeline check of this drug's brand
  // name (found or not) — see src/lib/ingestion/settlements/index.ts. Null
  // = never checked. Same resumable-batching role as
  // Company.litigationLastCheckedAt, but keyed by Drug (brand name is what
  // gets searched against EDGAR, not the applicant company — see
  // SettlementDisclosure's doc comment on why there's no parent-company
  // resolution here) rather than by Company.
  settlementsLastCheckedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patents          Patent[]
  exclusivities    Exclusivity[]
  ingestionRecords IngestionRecord[]
  challengeLinks   GenericChallengeDrug[]
  watchlistItems   WatchlistItem[]
  litigationLinks  LitigationCaseDrug[]
  settlementLinks  SettlementDisclosureDrug[]

  @@unique([applicationNumber, productNumber])
  @@index([brandName])
  @@index([genericName])
  @@index([companyId])
  @@index([modality])
  @@index([drugClass])
  @@index([dosageForm])
  @@index([settlementsLastCheckedAt])
}

// One licensed biologic product, from FDA's Purple Book — the biologics
// counterpart to Drug/Orange Book. Deliberately a separate model rather
// than force-fit into Drug: the natural key, vocabulary (License Type,
// Center), and the self-referential biosimilar/interchangeable/reference
// network below have no small-molecule analogue at all. Mirrors the Purple
// Book's own monthly product download row-for-row (BLA Number, Proprietary
// Name, Proper Name, License Type, Center, Ref. Product name fields, ...).
model BiologicProduct {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  blaNumber       String // e.g. "125057" — Purple Book's "BLA Number"
  productNumber   String // distinguishes strengths/presentations within one BLA
  proprietaryName String // e.g. "Humira"
  properName      String // FDA's own term for the biologic's nonproprietary name, e.g. "adalimumab" — the biologics analogue of Drug.genericName

  licenseType LicenseType
  center      BiologicCenter

  dosageForm      String
  route           String
  strength        String
  marketingStatus String? // e.g. "Rx", "Disc" — informational, not filtered on today

  approvalDate DateTime?

  // Biosimilar/interchangeable -> reference-product relationship. Purple
  // Book gives this as a NAME (Ref. Product Proprietary/Proper Name), not a
  // BLA number — resolved to a real FK by matching against other rows in
  // the same ingestion pass (see purpleBook/load.ts). referenceProductId is
  // null both for true reference products themselves and for the (common)
  // case where resolution fails or doesn't apply; referenceProductNameRaw
  // preserves the source's raw name in the unresolved case so that
  // information is never silently dropped.
  referenceProductId             String?
  referenceProduct               BiologicProduct?  @relation("ReferenceProduct", fields: [referenceProductId], references: [id])
  biosimilarsAndInterchangeables BiologicProduct[] @relation("ReferenceProduct")
  referenceProductNameRaw        String?

  // Same best-effort classification approach as Drug — see
  // src/lib/classification/. Defaults to UNCLASSIFIED, not SMALL_MOLECULE:
  // see the Modality enum doc comment for why biologics never get that
  // default.
  modality  Modality @default(UNCLASSIFIED)
  drugClass String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patents          Patent[]
  exclusivities    Exclusivity[]
  ingestionRecords IngestionRecord[]
  watchlistItems   WatchlistItem[]

  @@unique([blaNumber, productNumber])
  @@index([proprietaryName])
  @@index([properName])
  @@index([companyId])
  @@index([modality])
  @@index([drugClass])
  @@index([licenseType])
  @@index([referenceProductId])
}

// A patent listed against a drug product OR a biologic product — the same
// model serves both (drugId / biologicProductId, exactly one set, enforced
// by a hand-written CHECK constraint in the migration SQL, same pattern as
// IngestionRecord's below). Deliberately shared rather than a parallel
// BiologicPatent table: a patent number from Purple Book's disclosed
// patent list is a real USPTO patent number like any other, so the exact
// same PTA enrichment pipeline (src/lib/ingestion/pta/) applies to it with
// zero new code — sharing the table is what makes that free.
//
// nominalExpiryDate  = the legally listed / face-value expiry (as filed,
//                       or as printed/originally listed before adjustment;
//                       for a Purple Book patent, the source-asserted
//                       "Patent Expiration Date" until independently
//                       verified — see purpleBook/load.ts).
// effectiveExpiryDate = our best-known actual enforceable expiry, after
//                       Patent Term Adjustment, Patent Term Extension, and
//                       terminal disclaimers are applied.
// expiryAdjustmentDays = signed day delta between the two, when known.
//                       NULL means "adjustment not yet confirmed" (distinct
//                       from 0, which means "confirmed, no adjustment").
//
// See README.md "Data model" section for the full rationale.
model Patent {
  id     String  @id @default(cuid())
  drugId String?
  drug   Drug?   @relation(fields: [drugId], references: [id], onDelete: Cascade)

  biologicProductId String?
  biologicProduct   BiologicProduct? @relation(fields: [biologicProductId], references: [id], onDelete: Cascade)

  patentNumber String

  // Mirrors the Orange Book's own Drug_Substance_Flag / Drug_Product_Flag —
  // a single patent can cover both, so these are independent booleans
  // rather than a single lossy "type" enum.
  coversDrugSubstance Boolean @default(false)
  coversDrugProduct   Boolean @default(false)
  // FDA "patent use code" text; empty string unless this is a
  // method-of-use listing. Deliberately NOT nullable, even though "no use
  // code" is semantically a null: Postgres treats every NULL as distinct
  // in a unique constraint, so a nullable column here would make the
  // @@unique below unusable for idempotent upserts on the (very common)
  // rows with no use code — Prisma's generated compound-unique input type
  // requires non-null members for exactly this reason. "" is the sentinel.
  useCode             String  @default("")

  filingDate DateTime?

  nominalExpiryDate     DateTime
  effectiveExpiryDate   DateTime
  expiryAdjustmentDays  Int?
  hasTerminalDisclaimer Boolean  @default(false)

  submittedDate DateTime? // date the applicant submitted this patent for Orange Book listing
  delistedAt    DateTime? // set when a source reports this patent removed from the listing

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ingestionRecords IngestionRecord[]

  // Matches the Orange Book's own natural key. Deliberately does NOT
  // include the expiry dates, because those are exactly the mutable fields
  // ingestion should correct in place (see README). Continues to work
  // correctly now that drugId is nullable: every Orange Book row still has
  // a non-null drugId, so this constraint only ever compares those rows —
  // Postgres skips a row from a unique index's enforcement entirely as
  // soon as any ONE of that index's own columns is null, so this index
  // simply never "sees" Purple Book rows (whose drugId is always null) at
  // all, with no special handling needed.
  //
  // Purple Book rows get their own separate, independent uniqueness below
  // — (biologicProductId, patentNumber), no useCode (Purple Book has no
  // use-code concept; every biologic Patent row just leaves it at its ""
  // default) — which by the same NULL-skipping logic never "sees" Orange
  // Book rows (whose biologicProductId is always null) either. Two
  // separate 2/3-column indexes, each only ever enforced within its own
  // non-null population — NOT one index spanning both nullable FKs
  // together, which really would silently enforce nothing for either side.
  @@unique([drugId, patentNumber, useCode])
  @@unique([biologicProductId, patentNumber])
  @@index([effectiveExpiryDate])
  @@index([nominalExpiryDate])
}

// An FDA-granted regulatory exclusivity (separate legal mechanism from
// patents — e.g. New Chemical Entity, Orphan Drug, Pediatric, or — for
// biologics — a BPCIA reference-product/first-interchangeable exclusivity).
// FDA's exclusivity code vocabulary is large and grows over time, so `code`
// is kept as a raw string (from the source) rather than a rigid enum — an
// unrecognized code should never break ingestion. BPCIA codes
// (BPCIA_REF_PRODUCT, BPCIA_FIRST_INTERCHANGEABLE, ORPHAN) are new
// vocabulary in this same slot, not a new concept — see purpleBook/load.ts.
//
// Shared between Drug and BiologicProduct — same drugId/biologicProductId
// polymorphism and the same partial-unique-index caveat as Patent above.
model Exclusivity {
  id     String  @id @default(cuid())
  drugId String?
  drug   Drug?   @relation(fields: [drugId], references: [id], onDelete: Cascade)

  biologicProductId String?
  biologicProduct   BiologicProduct? @relation(fields: [biologicProductId], references: [id], onDelete: Cascade)

  code        String // raw FDA exclusivity code, e.g. "NCE", "ODE-123", "PED", "BPCIA_REF_PRODUCT"
  description String?

  grantedDate    DateTime?
  expirationDate DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ingestionRecords IngestionRecord[]

  // Matches the source's own natural key (Appl_No + Product_No + Code +
  // Date). Unlike Patent, the date IS part of the key here: FDA doesn't
  // "correct" an exclusivity date in place the way a PTA figure gets
  // corrected — a changed date represents a new determination. Still works
  // correctly with drugId nullable (same reasoning as Patent's @@unique
  // above); Purple Book rows get their own separate, independent
  // uniqueness on (biologicProductId, code, expirationDate).
  @@unique([drugId, code, expirationDate])
  @@unique([biologicProductId, code, expirationDate])
  @@index([expirationDate])
}

// How FDA's Date of First PIV Submission column encodes itself — see
// GenericChallenge.submissionDateType doc comment. Confirmed directly
// against a real download of FDA's Paragraph IV Certifications List PDF.
enum PivSubmissionDateType {
  EXACT_DATE
  PRE_MMA
  RECEIVED_PRIOR_TO
}

// FDA's own four terms for the 180-Day Decision Status column — kept as an
// enum (unlike Exclusivity.code) because this is a small, FDA-defined,
// stable vocabulary described explicitly on FDA's own page, not an
// open-ended one.
enum PivDecisionStatus {
  ELIGIBLE
  DEFERRED
  NON_FORFEITURE
  EXTINGUISHED
}

// One row from FDA's Paragraph IV Patent Certifications List — a signal
// that a generic company has filed (or resolved) a patent challenge
// against this RLD, tracked entirely separately from Patent/Exclusivity:
// it's not a patent (it doesn't itself define a legal term) and it's not
// an FDA exclusivity (it's a filing/status record about OTHER parties'
// applications against the RLD's patents). See README "Data ingestion:
// Paragraph IV Certifications" for the full field-by-field provenance and
// FDA's own stated caveat that its regulatory decisions are based on the
// underlying applications, not this published list.
//
// Deliberately ANDA/505(j)-only — biosimilars use the BPCIA patent-dance
// process instead, already tracked via Purple Book's own patent list, so
// this model links only to Drug, never BiologicProduct.
model GenericChallenge {
  id String @id @default(cuid())

  activeIngredient String // "Drug Name" column, as-is from the source
  dosageForm       String
  strength         String // raw strength cell — may list multiple strengths for one row, see rawStrengthText

  rldName         String // brand name of the reference listed drug
  rldNdaNumber    String? // normalized "NDA" + 6-digit number; null when the source row has no number at all (see README — ~5% of rows, mostly old Pre-MMA entries)
  rldNdaNumberRaw String? // the source's own last-line text when present but not a clean all-digits match (e.g. malformed), kept for debugging rather than silently discarded

  // NOT NULL sentinel for the natural key below — `rldNdaNumber ??
  // "NO_NDA:" + rldName`, computed at load time. rldNdaNumber itself can't
  // be the unique column: Postgres treats every NULL as distinct, so a
  // compound unique index containing a nullable column silently stops
  // deduplicating any row where that column is null — the ~5% of rows
  // with no NDA number would re-insert as a brand-new row on every re-run
  // instead of upserting in place. Same sentinel pattern already used for
  // Patent.useCode's `@default("")` for exactly this reason.
  naturalKeyNda String

  submissionDateType PivSubmissionDateType
  // Set for EXACT_DATE and RECEIVED_PRIOR_TO; null for PRE_MMA (FDA's own
  // text: individual per-patent dates aren't tracked under the pre-2003
  // statutory scheme, so there's genuinely no date to store, not a parse
  // failure). submissionDateType is what a consumer branches on — a
  // RECEIVED_PRIOR_TO row's date is a real, meaningful upper bound, not
  // interchangeable with an EXACT_DATE row's date, even though both live
  // in this same column.
  submissionDate     DateTime?

  potentialFirstApplicantAndaCount Int?

  // History of 180-Day Decision Status determinations, most-recent-first
  // — matches FDA's own stated ordering for both the Status and Posting
  // Date columns. Kept as JSON rather than a child table: a small,
  // source-owned, order-significant array that's never queried by its own
  // fields independently of the parent row (same rationale as
  // IngestionRun.summary's use of Json above). Shape:
  // [{ status: PivDecisionStatus, postingDate: string | null, rawStatusText: string }]
  // postingDate is null when the source lists a status with no
  // corresponding posting-date entry (confirmed real — a handful of rows
  // do this); rawStatusText preserves the source's own text for that
  // entry (e.g. a per-strength-qualified status like "40 u/100 mL -
  // Extinguished") since PivDecisionStatus alone can't capture that.
  decisionHistory Json
  // Denormalized decisionHistory[0].status (or null if decisionHistory is
  // empty) — the one thing actually filtered/displayed without needing to
  // unpack the JSON, mirroring why SearchResultSchema gets its own
  // hasGenericChallenge flag rather than making callers inspect a list.
  currentStatus   PivDecisionStatus?

  dateOfFirstApplicantApproval   DateTime?
  dateOfFirstCommercialMarketing DateTime?
  // Multi-value marketing-date cells (rare — different dates for
  // different strengths within one row) store the single value here only
  // when the source's own formatting is unambiguous to parse; otherwise
  // this stays null and the raw text lives in rawNotes with a logged
  // RowIssue, rather than guessing which date applies.

  // Reference-only — see README and the product-layer doc comment on
  // GenericChallengeCallout for why this is never conflated with
  // Patent.effectiveExpiryDate. FDA's own definition of this column
  // explicitly excludes pediatric exclusivity and reflects only
  // PIV-certified patents, not the drug's full protection picture.
  expirationOfLastQualifyingPatent DateTime?

  rawStrengthText String // full source strength cell verbatim, for the multi-strength case
  rawNotes        String? // any unparsed/ambiguous fragment from this row, preserved verbatim rather than dropped

  drugLinks        GenericChallengeDrug[]
  ingestionRecords IngestionRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Natural key for idempotent re-ingestion: the source PDF has no row ID
  // of its own, so this composite is the closest stable identifier built
  // from the source's own columns — same approach as Purple Book's
  // exclusivity natural key when no source ID existed. Uses naturalKeyNda
  // (NOT NULL sentinel), not the nullable rldNdaNumber directly — see its
  // doc comment above.
  @@unique([naturalKeyNda, activeIngredient, dosageForm, strength])
  @@index([rldNdaNumber])
  @@index([currentStatus])
  @@index([dateOfFirstCommercialMarketing])
}

// Many-to-many join between GenericChallenge and Drug — not a nullable FK
// on either side. Confirmed directly against real data that one PDF row's
// strength list can resolve to multiple existing Drug rows (e.g. one
// Nucynta ER challenge row spans 5 separate strength/productNumber rows
// under the same NDA) — a single nullable FK on either model couldn't
// represent that. See README's product-matching section.
model GenericChallengeDrug {
  id                 String           @id @default(cuid())
  genericChallengeId String
  genericChallenge   GenericChallenge @relation(fields: [genericChallengeId], references: [id], onDelete: Cascade)
  drugId             String
  drug               Drug             @relation(fields: [drugId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([genericChallengeId, drugId])
  @@index([drugId])
}

// Which of the two districts this pipeline is scoped to. A real, closed
// enum even though CourtListener's own court_id vocabulary is large and
// open globally — we constrain every search to exactly these two courts
// at the query layer (src/lib/ingestion/litigation/client.ts always
// requests court=deld,njd), so ingestion itself can never legitimately
// produce a third value; LitigationDocket.courtRaw keeps CourtListener's
// own court_id string verbatim for traceability regardless.
enum LitigationCourt {
  DE
  NJ
}

// Our own inferred classification of how a dispute concluded — a small,
// closed taxonomy we define (like PivDecisionStatus), not an open
// vocabulary ingested verbatim from an external source (unlike
// Exclusivity.code). ONGOING/UNCLEAR are the only values the v1 pipeline
// can derive (from a docket's dateTerminated alone) — the rest exist for
// a possible future enrichment pass that reads docket-entry text, and are
// never guessed into without that corroborating evidence.
enum LitigationOutcome {
  ONGOING
  SETTLED
  DISMISSED
  RULING_FOR_PLAINTIFF
  RULING_FOR_DEFENDANT
  TRANSFERRED
  UNCLEAR
}

// How confident the automated company/product matching is that a
// CourtListener docket hit is (a) genuinely Hatch-Waxman/ANDA litigation
// and (b) correctly attributed to a specific company pair and product —
// see src/lib/ingestion/litigation/match.ts's scoreConfidence(). This is
// deliberately a weaker-confidence signal than every other source in this
// schema (Orange Book/Purple Book/PTA/Paragraph IV all link via exact
// NDA/RLD/patent-number fields); the UI must never present it with the
// same visual certainty as those.
enum LitigationMatchConfidence {
  HIGH
  MEDIUM
  LOW
}

// One Hatch-Waxman/ANDA litigation DISPUTE, which can span multiple real
// court dockets (see LitigationDocket below): a single dispute commonly
// splits into several associated case numbers within one district, and a
// case can transfer between districts mid-dispute (each docket keeps its
// own court, so a transfer is just two docket rows under one case, not a
// mutation of one row). Grouping dockets into one LitigationCase is
// itself a best-effort heuristic (normalized party-pair match + filing-
// date proximity — see findOrCreateLitigationCase in
// src/lib/ingestion/litigation/load.ts), same spirit as
// paragraphIV/load.ts's tokenOverlap dosage-form matching: useful, not
// guaranteed-correct clustering.
//
// plaintiffCompanyId/defendantCompanyId are two INDEPENDENTLY nullable
// FKs to the same model (Company), not an either/or pair — a different
// shape from Patent/Exclusivity/WatchlistItem's drugId-XOR-
// biologicProductId pattern, so no CHECK constraint applies here.
// *NameRaw always holds the source's own case-caption-derived string,
// even when a Company match succeeds, so the original text is never lost.
model LitigationCase {
  id String @id @default(cuid())

  plaintiffCompanyId String?
  plaintiffCompany   Company? @relation("LitigationPlaintiff", fields: [plaintiffCompanyId], references: [id])
  plaintiffNameRaw   String // as split from CourtListener's caseName, e.g. "Vanda Pharmaceuticals Inc."

  defendantCompanyId String?
  defendantCompany   Company? @relation("LitigationDefendant", fields: [defendantCompanyId], references: [id])
  defendantNameRaw   String

  // Derived from dockets[].filingDate (earliest) on every load — not
  // independently editable, so it stays in sync with the child rows.
  earliestFilingDate DateTime?

  // Derived — see deriveCaseOutcome() in match.ts. Never set directly
  // from search-hit text.
  outcome     LitigationOutcome @default(ONGOING)
  outcomeNote String? // explanation of how `outcome` was derived, shown next to the outcome badge in the UI

  matchConfidence LitigationMatchConfidence
  matchNote       String? // human-readable "why this tier" explanation — see match.ts scoreConfidence(); always rendered in the UI, not hidden behind a tooltip

  // Stamped after every complaint-enrichment check of this case (found
  // usable identifiers or not) — see src/lib/ingestion/litigation/
  // complaintEnrich.ts. Null = never checked. Same resumable-batching
  // watermark role as Company.litigationLastCheckedAt and
  // Drug.settlementsLastCheckedAt, but per-case: this pipeline fetches
  // the COMPLAINT (Document 1) for a case already in this table, an
  // entirely separate CourtListener call from the company-name search
  // that created the case in the first place.
  complaintCheckedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dockets          LitigationDocket[]
  drugLinks        LitigationCaseDrug[]
  ingestionRecords IngestionRecord[]

  @@index([plaintiffCompanyId])
  @@index([defendantCompanyId])
  @@index([outcome])
  @@index([complaintCheckedAt])
}

// One row per actual CourtListener RECAP docket — the thing that really
// has a case number, a specific court, and a specific judge. Multiple
// rows can belong to one LitigationCase (multi-docket dispute; also how a
// district transfer is represented — pre- and post-transfer dockets are
// two separate rows here, each with its own court).
model LitigationDocket {
  id               String         @id @default(cuid())
  litigationCaseId String
  litigationCase   LitigationCase @relation(fields: [litigationCaseId], references: [id], onDelete: Cascade)

  // CourtListener's own numeric docket id (search response's `docket_id`)
  // — the natural key for idempotent upsert. NOT the same as docketNumber
  // (the human-readable case number), which isn't guaranteed unique
  // across courts. Nullable (unlike every other field on this model that
  // isn't) specifically for manually-entered dockets with no CourtListener
  // lookup at all (see src/lib/ingestion/manualEntry) — e.g. a case too
  // recent to be in RECAP yet. Postgres treats every NULL as distinct in
  // a unique index, so multiple such rows coexist fine.
  externalDocketId Int? @unique

  docketNumber String // e.g. "1:23-cv-01234", human-readable case number

  court    LitigationCourt
  courtRaw String // CourtListener's own court_id ("deld" / "njd"), kept verbatim for traceability/debugging

  filingDate     DateTime?
  dateTerminated DateTime?
  judge          String? // CourtListener's assignedTo, as-is
  natureOfSuit   String? // CourtListener's suitNature (e.g. "830 Patent") — open vocabulary, plain string, same reasoning as Exclusivity.code

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([litigationCaseId])
  @@index([court])
}

// Many-to-many join between LitigationCase and Drug — same shape as
// GenericChallengeDrug (genuine M2M, not the nullable-FK/CHECK-constraint
// pattern), because a dispute's product link is either absent (no
// confident match) or can span more than one strength/productNumber row
// under the same NDA.
model LitigationCaseDrug {
  id               String         @id @default(cuid())
  litigationCaseId String
  litigationCase   LitigationCase @relation(fields: [litigationCaseId], references: [id], onDelete: Cascade)
  drugId           String
  drug             Drug           @relation(fields: [drugId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([litigationCaseId, drugId])
  @@index([drugId])
}

// How much structure backs an extracted settlement fact — see
// src/lib/ingestion/settlements/extract.ts. HIGH = the filing's own
// templated "<Drug> Patent Litigation (<Counterparty>) - ..." heading
// matched AND an explicit "beginning <date>" licensed-entry date was
// found. MEDIUM = the heading/settlement narrative matched but no
// explicit licensed-entry date could be pulled out (e.g. a different
// phrasing). LOW = only a weak keyword-proximity signal, no clean
// template match. Same "never presented with the same visual certainty
// as an exact-ID match" rule as LitigationMatchConfidence — if anything
// this is the WEAKER of the two, since it's free-text extraction, not
// even a company-name match.
enum SettlementExtractionConfidence {
  HIGH
  MEDIUM
  LOW
}

// A drug patent litigation SETTLEMENT disclosed in a company's own SEC
// filing (10-K/10-Q), not a RECAP court docket — see
// src/lib/ingestion/settlements/. Exists because a settlement that
// resolves litigation without a clean, attributable court disposition
// (the common real-world shape: parties stipulate dismissal, and the
// actual terms — a licensed generic-entry date — live only in the
// settlement agreement, voluntarily disclosed in the next 10-K/10-Q) is
// invisible to RECAP-only sourcing, the gap LitigationCase's own doc
// comment doesn't cover. Real case this was built against: Bausch
// Health's 2018 Xifaxan/Actavis settlement, disclosed in BHC's 10-Q
// filings with an explicit "beginning January 1, 2028" licensed
// generic-entry date that never appears in any RECAP docket for that
// case.
//
// No attempt is made to resolve filingCompanyNameRaw to a Company row —
// SEC filings are made at the parent-company level (e.g. Bausch Health),
// while Orange Book's Company rows are the NDA-holder subsidiary (e.g.
// Salix); this schema has no parent/subsidiary relationship to bridge
// that (see Company's doc comment), so the raw filer name is kept as-is
// rather than guessed at. Matching to a Drug instead goes through
// drugNameRaw (brand name) directly — see settlements/index.ts.
//
// Deliberately the SECOND-lowest-confidence source in this schema (after
// LitigationCase itself) — extracted from filing PROSE via a hand-written
// text pattern, not an exact-ID match. Always pair with
// extractionConfidence/extractionNote in the UI, and never silently
// replace a computed estimate.
model SettlementDisclosure {
  id String @id @default(cuid())

  drugNameRaw String // brand name searched for, as it appears in the filing text (e.g. "Xifaxan")

  counterpartyNameRaw   String // the other party, as extracted from the "... Patent Litigation (<Counterparty>)" heading
  counterpartyCompanyId String?
  counterpartyCompany   Company? @relation("SettlementCounterparty", fields: [counterpartyCompanyId], references: [id])

  filingCompanyNameRaw String // SEC's own display name for the filer, e.g. "Bausch Health Companies Inc." — see doc comment above on why this isn't resolved to a Company row

  settlementAnnouncedDate   DateTime?
  licensedEntryDate         DateTime?
  earlierCircumstancesNoted Boolean   @default(false) // filing text noted the license could start earlier under certain conditions (e.g. a competing generic launching first)

  sourceForm       String // EDGAR's own form type — "10-K" | "10-Q" | "10-Q/A" etc.
  sourceFileDate   DateTime
  sourceFilingUrl  String
  extractedExcerpt String // the raw matched paragraph, so a human can verify the extraction without leaving the page

  extractionConfidence SettlementExtractionConfidence
  extractionNote       String // human-readable "why this tier" — always rendered, same convention as LitigationCase.matchNote

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  drugLinks        SettlementDisclosureDrug[]
  ingestionRecords IngestionRecord[]

  @@unique([sourceFilingUrl, drugNameRaw, counterpartyNameRaw])
  @@index([counterpartyCompanyId])
  @@index([drugNameRaw])
}

// Many-to-many join between SettlementDisclosure and Drug — same shape as
// LitigationCaseDrug/GenericChallengeDrug, since one filing's disclosure
// can plausibly cover more than one strength/productNumber row under the
// same NDA (drugNameRaw matches by brand name, which spans all of them).
model SettlementDisclosureDrug {
  id                     String               @id @default(cuid())
  settlementDisclosureId String
  settlementDisclosure   SettlementDisclosure @relation(fields: [settlementDisclosureId], references: [id], onDelete: Cascade)
  drugId                 String
  drug                   Drug                 @relation(fields: [drugId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([settlementDisclosureId, drugId])
  @@index([drugId])
}

// A user-curated shortlist — one row per (user, product) they've starred
// from that product's detail page. Polymorphic across Drug/BiologicProduct
// (same drugId/biologicProductId-nullable-pair pattern as Patent/
// Exclusivity/IngestionRecord above, including the hand-written
// exactly-one-parent CHECK constraint in the migration SQL).
//
// userId is a plain string, not a Prisma relation to User: the User model
// below is generated by Better Auth (`npx auth generate`) and its own
// doc comment warns against hand-editing it, so this deliberately doesn't
// add a back-relation there — a lookup by userId works fine without one.
model WatchlistItem {
  id     String @id @default(cuid())
  userId String

  drugId String?
  drug   Drug?   @relation(fields: [drugId], references: [id], onDelete: Cascade)

  biologicProductId String?
  biologicProduct   BiologicProduct? @relation(fields: [biologicProductId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, drugId])
  @@unique([userId, biologicProductId])
  @@index([userId])
}

// An external system or process that supplies data: e.g. "FDA Orange Book",
// "USPTO Patent Term Calculator", "Manual Entry".
model DataSource {
  id        String   @id @default(cuid())
  name      String   @unique
  url       String?
  createdAt DateTime @default(now())

  ingestionRecords IngestionRecord[]
  ingestionRuns    IngestionRun[]
}

enum IngestionRunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
  // User-requested stop, not an error — only PTA and litigation check for
  // this (see src/lib/ingestion/cancellation.ts): both loop one candidate
  // at a time with a real await between each, the same shape their own
  // abortedOnAuthError break already used, so mid-run cancellation reuses
  // that pattern rather than introducing a new one. Orange Book/Purple
  // Book/Paragraph IV run in seconds as monolithic fetch+parse+load steps
  // with no such loop to check inside, so they don't support this.
  CANCELLED
}

// One row per pipeline execution — the run-level counterpart to
// IngestionRecord's per-entity log. Answers "did last night's ingestion
// work, and what happened" without grepping log files.
model IngestionRun {
  id       String     @id @default(cuid())
  sourceId String
  source   DataSource @relation(fields: [sourceId], references: [id])

  status     IngestionRunStatus @default(RUNNING)
  startedAt  DateTime           @default(now())
  finishedAt DateTime?

  // Set by the /data page's Stop button (via /api/data/ingest/stop) while
  // this run is RUNNING. Deliberately a DB column, not an in-memory flag —
  // an in-memory Set keyed by pipeline name looked simpler at first, but
  // Next's dev bundler can give two different route files (the trigger
  // route and the stop route both import orchestrator.ts) separately
  // bundled copies of the same shared module, so a flag set from one
  // route's copy was invisible to the pipeline running under the other's —
  // confirmed directly: a Stop call returned 202 but the run finished
  // normally 40s later, never having seen cancelRequested flip. The DB is
  // the one thing both routes are already proven to share reliably.
  cancelRequested Boolean @default(false)

  drugsUpserted         Int @default(0)
  patentsUpserted       Int @default(0)
  exclusivitiesUpserted Int @default(0)
  rowsSkipped           Int @default(0)

  // Structured details: per-file row counts, sample skipped-row reasons,
  // error message on failure. Free-form on purpose — this is for humans
  // debugging a run, not for querying.
  summary Json?

  @@index([sourceId, startedAt])
}

// Append-only log of every time a Drug/Patent/Exclusivity row was ingested
// or manually verified from a given source. This is the answer to "what's
// stale": the most recent row per (entity, source) tells you when it was
// last confirmed true. Kept as full history (not a single denormalized
// "lastVerifiedAt" column) so disagreeing sources and value changes over
// time stay auditable.
//
// Exactly one of drugId / patentId / exclusivityId / biologicProductId /
// genericChallengeId / litigationCaseId / settlementDisclosureId must be
// set — enforced by a CHECK constraint added by hand in the migration SQL
// (Prisma's schema language has no first-class check-constraint support
// yet). If you ever regenerate this migration from scratch, re-add that
// constraint (now 7-way: originally just drug/patent/exclusivity,
// extended for BiologicProduct, extended again for GenericChallenge,
// extended again for LitigationCase, extended again for
// SettlementDisclosure).
model IngestionRecord {
  id String @id @default(cuid())

  sourceId String
  source   DataSource @relation(fields: [sourceId], references: [id])

  drugId String?
  drug   Drug?   @relation(fields: [drugId], references: [id], onDelete: Cascade)

  patentId String?
  patent   Patent? @relation(fields: [patentId], references: [id], onDelete: Cascade)

  exclusivityId String?
  exclusivity   Exclusivity? @relation(fields: [exclusivityId], references: [id], onDelete: Cascade)

  biologicProductId String?
  biologicProduct   BiologicProduct? @relation(fields: [biologicProductId], references: [id], onDelete: Cascade)

  genericChallengeId String?
  genericChallenge   GenericChallenge? @relation(fields: [genericChallengeId], references: [id], onDelete: Cascade)

  litigationCaseId String?
  litigationCase   LitigationCase? @relation(fields: [litigationCaseId], references: [id], onDelete: Cascade)

  settlementDisclosureId String?
  settlementDisclosure   SettlementDisclosure? @relation(fields: [settlementDisclosureId], references: [id], onDelete: Cascade)

  externalRef String? // the source's own id/url for this record, for traceability + dedupe — holds the triggering CourtListener docket id for litigation records, or the EDGAR filing URL for settlement records
  verifiedAt  DateTime @default(now())
  changeNote  String? // optional human-readable note of what changed, if anything
  rawPayload  Json? // optional raw snapshot from the source, for debugging ingestion

  // Set only when sourceId points at the "Manual Entry" DataSource — which
  // Analyst entered or manually verified this record. Plain string, not a
  // Prisma relation, same reasoning as WatchlistItem.userId: User is
  // Better-Auth-generated and its own doc comment warns against
  // hand-editing it, so no back-relation is added here either.
  enteredByUserId String?

  createdAt DateTime @default(now())

  @@index([drugId, verifiedAt])
  @@index([patentId, verifiedAt])
  @@index([exclusivityId, verifiedAt])
  @@index([biologicProductId, verifiedAt])
  @@index([genericChallengeId, verifiedAt])
  @@index([litigationCaseId, verifiedAt])
  @@index([settlementDisclosureId, verifiedAt])
  @@index([sourceId, verifiedAt])
}

// ---------------------------------------------------------------------
// Auth (Better Auth). Schema below this line is generated by
// `npx auth generate` from src/lib/auth.ts, not hand-written — re-run that
// command (diff before applying) rather than editing these models by hand
// if the auth config ever changes (e.g. a new plugin). Table names are
// lowercase (`@@map("user")` etc.) because that's Better Auth's own
// convention across all its adapters; left as generated rather than
// renamed to match this file's usual PascalCase, so future regenerations
// stay a clean diff.
//
// `role` ("admin" | "user", nullable — see databaseHooks in auth.ts, which
// always sets it explicitly on signup) is the entire access-tier system:
// "admin" is presented in the product as "Analyst" (elevated — can manage
// other users from /team), "user" as "Subscriber" (the paying-customer
// tier — read access to the product). See src/lib/session.ts.

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

// One row per login method for a user. For our email/password-only setup
// there's exactly one Account per User (providerId "credential", password
// hash here) — the table exists as a generic join because Better Auth
// supports linking multiple sign-in methods (e.g. social) to one user.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

// Short-lived tokens for flows we don't use yet (email verification,
// password reset) — present because Better Auth's core schema always
// includes it, empty in practice until those flows are built.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
